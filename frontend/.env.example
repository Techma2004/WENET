VITE_API_URL=https://your-backend.onrender.com

# --- Crash reporting (optional) ---
# From https://sentry.io — matches backend SENTRY_DSN but is a separate
# Sentry project (frontend errors vs. backend errors). Leave blank to disable.
VITE_SENTRY_DSN=""

# --- Analytics (optional) ---
# From https://posthog.com. Leave blank to disable — no events are sent
# anywhere and the app behaves identically either way.
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://app.posthog.com"

# --- Push notifications (optional) ---
# From your Firebase project settings (Project settings > General, and
# Cloud Messaging > Web Push certificates for the VAPID key). All of these
# are required together for the "enable notifications" button to work; if
# any are missing, that button just explains it's not configured instead
# of failing. NOTE: also copy these same values into
# public/firebase-messaging-sw.js — service workers can't read this file.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_VAPID_KEY=""
