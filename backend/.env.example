# --- Database (required) ---
# Neon/Postgres connection string. Must include sslmode=require for Neon.
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/wenet?sslmode=require&connection_limit=5&pool_timeout=10"

# --- Auth (required) ---
# Used to sign login tokens AND to hash phone numbers before they're stored.
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="change-this-super-secret-32-chars-min"

# --- CORS (required in production) ---
# Comma-separated list of origins allowed to call this API / open a socket
# (your deployed frontend URL, and http://localhost:5173 for local dev).
# Leave as "*" only while testing - it allows any site to call your API.
CORS_ORIGIN="https://your-frontend.onrender.com,http://localhost:5173"

# --- Media uploads (required for photo/video messages and avatars) ---
# From your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="123456"
CLOUDINARY_API_SECRET="your-secret"

# --- Push notifications (optional) ---
# Paste the full contents of a Firebase service-account JSON file as a
# single-line string. If omitted, push notifications are silently skipped
# and everything else keeps working.
FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'

# --- Transactional email (required for email verification + password reset) ---
# From https://resend.com — free tier is enough for a personal project.
# If omitted, verification/reset links are logged to the server console
# instead of emailed, so local dev still works without an account.
RESEND_API_KEY=""
EMAIL_FROM="WENET <onboarding@resend.dev>"

# --- Frontend URL (required for email links to point somewhere real) ---
# Used to build the verify-email and reset-password links sent by email.
APP_URL="http://localhost:5173"

# --- Server (optional, Render sets PORT itself) ---
PORT=10000
NODE_ENV=production
