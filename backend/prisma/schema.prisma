generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  phoneHash    String        @unique
  passwordHash String
  displayName  String
  bio          String?       @default("Hey there! I'm on WENET")
  avatarUrl    String?
  publicKey    String        @db.Text
  isOnline     Boolean       @default(false)
  lastSeen     DateTime      @default(now())
  devices      Device[]
  groupMembers GroupMember[]
  contacts     Contact[]     @relation("owner")
  blocked      Block[]       @relation("blocker")
  blockedBy    Block[]       @relation("blocked")
  reactions    Reaction[]
  statuses     Status[]
  createdAt    DateTime      @default(now())
}

model Device {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken String?
  lastSeen DateTime @default(now())

  @@index([userId])
}

model Group {
  id          String        @id @default(uuid())
  name        String
  description String?
  avatarUrl   String?
  createdBy   String
  isGroup     Boolean       @default(true)
  inviteLink  String        @unique @default(uuid())
  members     GroupMember[]
  messages    Message[]
  createdAt   DateTime      @default(now())
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  role     String   @default("MEMBER") // ADMIN, MEMBER
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Message {
  id              String        @id @default(cuid())
  clientMessageId String        @unique
  roomId          String // for 1:1 = sorted user ids, for group = groupId
  senderId        String
  recipientId     String? // null for group messages
  groupId         String?
  group           Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  encryptedPayload String       @db.Text
  iv              String
  replyToId       String?
  mediaUrl        String?
  mediaThumbUrl   String?
  mediaType       String? // image, video, audio, file
  isEdited        Boolean       @default(false)
  isDeleted       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  deliveredAt     DateTime?
  readBy          MessageRead[]
  reactions       Reaction[]

  @@index([roomId])
  @@index([groupId])
  @@index([recipientId, deliveredAt])
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model Contact {
  id        String   @id @default(uuid())
  ownerId   String
  contactId String
  owner     User     @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, contactId])
}

model Block {
  id        String @id @default(uuid())
  blockerId String
  blockedId String
  blocker   User   @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User   @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Status {
  id        String   @id @default(uuid())
  userId    String
  mediaUrl  String
  mediaType String   @default("image")
  caption   String?
  expiresAt DateTime // 24h later
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
